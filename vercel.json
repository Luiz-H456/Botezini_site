{
  "rewrites": [
    { "source": "/cores", "destination": "/src/cores.html" },
    { "source": "/(.*)", "destination": "/src/$1" }
  ],
  "headers": [
    {
      "source": "/(.*).(webp|png|jpg|jpeg|svg|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
